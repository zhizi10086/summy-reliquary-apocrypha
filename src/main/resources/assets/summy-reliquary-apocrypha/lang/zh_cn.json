  "itemGroup.summy-reliquary-apocrypha.main": "Summy Reliquary: Apocrypha",

  "item.summy-reliquary-apocrypha.new_testament": "新约",
  "item.summy-reliquary-apocrypha.new_testament.desc.1": "「看哪，我将一切都更新了。」",
  "item.summy-reliquary-apocrypha.new_testament.desc.2": "箭矢落处，恩典随之。",
  "item.summy-reliquary-apocrypha.new_testament.shift.1": "弓箭命中|回复 %s 点生命",
  "item.summy-reliquary-apocrypha.new_testament.shift.2": "命中时有 %s%% 概率在目标上方 %s 格处落下 %s~%s 支箭矢（散布 0~%s°）",
  "item.summy-reliquary-apocrypha.new_testament.shift.3": "落箭|%s 点真实伤害",
  "item.summy-reliquary-apocrypha.new_testament.shift.4": "落箭无视护甲、保护附魔、抗性与无敌帧",
  "item.summy-reliquary-apocrypha.new_testament.shift.5": "落箭为固定伤害（不参与 Summy Reliquary 的增伤乘区），并受「圣心」的箭矢追踪牵引",

  "item.summy-reliquary-apocrypha.swift_feather_covenant": "迅羽·协约",
  "item.summy-reliquary-apocrypha.swift_feather_covenant.desc.1": "「如鹰展翅上腾，奔跑却不困倦。」",
  "item.summy-reliquary-apocrypha.swift_feather_covenant.desc.2": "与新约同戴时，箭落如翼。",
  "item.summy-reliquary-apocrypha.swift_feather_covenant.shift.1": "仅在与「新约」同戴时生效：",
  "item.summy-reliquary-apocrypha.swift_feather_covenant.shift.2": "落箭触发概率|提升至 %s%%",
  "item.summy-reliquary-apocrypha.swift_feather_covenant.shift.3": "落箭初速|+%s%%",
  "item.summy-reliquary-apocrypha.swift_feather_covenant.shift.4": "落箭伤害|触发之箭最终伤害的 %s%%",
  "item.summy-reliquary-apocrypha.swift_feather_covenant.shift.5": "落箭伤害按触发之箭「各类倍率结算后」的金额计算，且不再叠加增益；仍为真实伤害、无视无敌帧",

  "item.summy-reliquary-apocrypha.wing_feather_sacrament": "翼羽·圣餐",
  "item.summy-reliquary-apocrypha.wing_feather_sacrament.desc.1": "「你的箭要如羽翼，带下天上的粮。」",
  "item.summy-reliquary-apocrypha.wing_feather_sacrament.desc.2": "新约治愈你时，光羽在你背后凝聚。",
  "item.summy-reliquary-apocrypha.wing_feather_sacrament.shift.1": "与「新约」同戴时：每次治疗触发凝聚一对光羽（最多可存 4 对）；攒满 3 对（6 片）时背后才显现那一对光翼，跌破 3 对即消失",
  "item.summy-reliquary-apocrypha.wing_feather_sacrament.shift.2": "攒到第 4 对后射击：消耗 1 对，使该箭成为圣餐之矢",
  "item.summy-reliquary-apocrypha.wing_feather_sacrament.shift.3": "圣餐之矢伤害|+%s%%",
  "item.summy-reliquary-apocrypha.wing_feather_sacrament.shift.4": "圣餐之矢落箭|固定 %s 支",
  "item.summy-reliquary-apocrypha.wing_feather_sacrament.shift.5": "圣餐之矢必定触发新约；脱战 %s 秒后每 %s 秒熄灭一对光羽",

  "item.summy-reliquary-apocrypha.inverse_feather_hover": "逆羽·滞空",
  "item.summy-reliquary-apocrypha.inverse_feather_hover.desc.1": "「他使我躺卧在青草地上，领我在可安歇的水边。」",
  "item.summy-reliquary-apocrypha.inverse_feather_hover.desc.2": "羽翼逆风而生，令坠落也变得迟缓。",
  "item.summy-reliquary-apocrypha.inverse_feather_hover.shift.1": "处于下落状态时（不在地面且正在下落）：",
  "item.summy-reliquary-apocrypha.inverse_feather_hover.shift.2": "箭矢伤害|+%s%%",
  "item.summy-reliquary-apocrypha.inverse_feather_hover.shift.3": "新约触发概率|×%s%%",
  "item.summy-reliquary-apocrypha.inverse_feather_hover.shift.4": "落箭伤害判定改为瞬时结算（按箭数逐笔，箭矢只作视觉）",
  "item.summy-reliquary-apocrypha.inverse_feather_hover.shift.5": "被动：空中长按潜行键下落速度降低 %s%%（落地按坠落高度 −%s%% 计算伤害）；空中按跳跃键可额外跳 %s 次（二段跳会立刻清空坠落高度）",

  "item.summy-reliquary-apocrypha.paired_wings": "比翼·连携",
